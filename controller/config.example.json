{
  "listen_host": "0.0.0.0",
  "listen_port": 8790,

  "public_host": "__PUBLIC_HOST__",

  "dashboard_token": "__DASHBOARD_TOKEN__",

  "mediamtx_rtmp_host": "127.0.0.1",
  "mediamtx_rtmp_port": 1935,
  "obs_pass": "__OBS_PASS__",
  "internal_user": "internal",
  "internal_pass": "__INTERNAL_PASS__",

  "pipelines": [
    {
      "name": "main",
      "is_default": true,
      "enabled": true,
      "live_path": "live/main",
      "backup_file": "__BASE_DIR__/backup/backup.mp4",
      "primary_name": "primary",
      "primary_server": "rtmp://live.twitch.tv/app",
      "primary_key": "CHANGE_ME_STREAM_KEY",
      "primary_enabled": true,
      "restreams": []
    }
  ],

  "offline_timeout_sec": 1800,
  "connect_timeout_ms": 5000,
  "read_timeout_ms": 500,
  "icmp_ping": false,

  "log_file": "__BASE_DIR__/controller/controller.log"
}
