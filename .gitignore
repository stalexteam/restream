# Generated by install.sh from *.template/*.example.json -- contains
# passwords and a token specific to this installation, not tracked.
/mediamtx.yml
/controller/config.json
/controller/config.test.json

# Self-signed TLS certificate that MediaMTX generates itself on first
# start (CN=mediamtx) -- not our config, a secret key.
/auto.crt
/auto.key

# MediaMTX binary -- downloaded by install.sh, not tracked.
/bin/*
!/bin/.gitkeep

# User's backup video and auto-prepared copies (BackupPreparer) --
# files specific to this installation, not to the project.
/backup/*
!/backup/.gitkeep

# PID files from restreamctl.sh
/.mediamtx.pid
/.controller.pid

# Logs (controller, ffmpeg processes, MediaMTX)
*.log

# Python
__pycache__/
*.pyc

# Development context/notes -- not part of the distributed project.
/CLAUDE.md
