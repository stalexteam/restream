# MediaMTX configuration for the restream-controller project.
# This is a TEMPLATE -- install.sh fills in real passwords and creates
# a working mediamtx.yml from it. The placeholders below (in "pass:"
# fields) are replaced automatically on every install.sh run (fresh
# passwords are generated each time).

logLevel: info
logDestinations: [stdout]

# How long to wait for data from OBS before considering the connection
# dead and closing it (even if the TCP socket itself is still open --
# a "silent" drop: the network is gone, but the connection hasn't
# formally closed yet). This closing is exactly what triggers
# runOnUnavailable below -> the backup video, as a slow backstop.
#
# This value is DERIVED, not something to hand-edit: it's
# connect_timeout_ms + read_timeout_ms from controller/config.json,
# recalculated and overwritten right before every MediaMTX start --
# by restreamctl.sh (manual `start`/`restart`) or by the controller
# itself (dashboard Settings -> Apply & Restart,
# controller/mediamtx_control.py). Editing it here by hand has no
# lasting effect; it'll be overwritten on the next start. Fast
# detection of a stalled stream during an active broadcast is handled
# separately, at the controller level (read_timeout_ms) -- this
# combined value only needs to comfortably cover the RTMP handshake +
# first-frame wait. A real OBS client needs noticeably more of this
# than a synthetic test source (encoder warm-up + first keyframe can
# take a couple of seconds on their own) -- see connect_timeout_ms's
# own minimum in controller/settings_store.py.
readTimeout: 5500ms

# We don't need MediaMTX's control API -- the controller manages the
# ffmpeg processes directly, so it's disabled to avoid an unnecessary
# attack surface.
api: false

# RTMP is the only protocol we need (OBS publishes over RTMP).
rtmp: true
rtmpAddress: :1935
# Other protocols are disabled -- not used by this project.
rtsp: no
hls: no
webrtc: no
srt: no

# --- Authentication ---
# By default MediaMTX allows anonymous publishing to anything -- this
# is intentionally disabled. Only two explicitly defined users remain.
authMethod: internal
authInternalUsers:
  # OBS publishes its stream here. The password is only valid for this path.
  - user: obs
    pass: __OBS_PASS__
    ips: []
    permissions:
      - action: publish
        path: live/main

  # Internal user for the controller's own ffmpeg process (relay reads
  # live/main). Restricted to localhost only -- this account can't be
  # used from the internet even if the password is known. Switching
  # between live and backup happens outside MediaMTX (inside the
  # controller itself), so there's only one path and one permission here.
  - user: internal
    pass: __INTERNAL_PASS__
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: read
        path: live/main

# --- Paths ---
paths:
  live/main:
    # MediaMTX calls these hooks when the publisher (OBS) appears or
    # disappears. The hooks themselves don't decide anything -- they
    # just notify the controller, and all the logic (fallback video,
    # timeout, graceful stop) lives in controller.py.
    runOnAvailable: curl -s -X POST http://127.0.0.1:8790/hooks/available
    runOnAvailableRestart: false
    runOnUnavailable: curl -s -X POST http://127.0.0.1:8790/hooks/unavailable
